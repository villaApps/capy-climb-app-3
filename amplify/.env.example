# ============================================
# Capybara Wellness - AWS Amplify Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_PROFILE=default

# ============================================
# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Apple Sign In Configuration
# Get from: https://developer.apple.com/account/resources/identifiers/list/serviceId
# ============================================
APPLE_CLIENT_ID=com.yourcompany.capybarawellness
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_CONTENT
-----END PRIVATE KEY-----

# ============================================
# SES Configuration (for email notifications)
# ============================================
SES_FROM_EMAIL=noreply@capybarawellness.app
SES_REGION=us-east-1

# ============================================
# SNS Configuration (for push notifications)
# ============================================
SNS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS/your-app-name

# ============================================
# App Configuration
# ============================================
APP_NAME=Capybara Wellness
APP_URL=https://capybarawellness.app

# ============================================
# Data API Configuration (auto-populated by Amplify)
# ============================================
# DATA_GRAPHQL_ENDPOINT=auto-populated
